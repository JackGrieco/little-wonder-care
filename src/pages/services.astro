---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DiscoveryCallButton from '../components/DiscoveryCallButton.astro';
import DiscoveryCallCard from '../components/DiscoveryCallCard.astro';
import PackagesSection from '../components/PackagesSection.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Services & Packages — Little Wonder Care"
			description="Gentle sleep coaching and postpartum doula services. Find the right support package for your family."
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Page Hero -->
			<div class="page-hero bg-crema">
				<p class="eyebrow">Services &amp; Packages</p>
				<h1>Find the Right Support for Your Family</h1>
				<p class="subtitle">
					Whether you need help with sleep, postpartum recovery, or just someone
					to talk to — I'm here. Choose the option that fits your needs.
				</p>
			</div>

			<!-- Packages: sleep, doula, then the free discovery call -->
			<div class="section">
				<div class="section-inner">
					<div class="section-header">
						<p class="section-eyebrow">Packages</p>
						<h2 class="section-title">Services &amp; Pricing</h2>
					</div>

					<PackagesSection category="sleep" />
					<PackagesSection category="doula" />
					<DiscoveryCallCard />
				</div>
			</div>

			<!-- CTA Band -->
			<section class="cta-band">
				<h2>Ready to Take the First Step?</h2>
				<p>
					Book a free 15-minute call. Let's talk about your needs and find the
					right solution for your family.
				</p>
				<DiscoveryCallButton
					variant="btn-cta-light"
					label="Book Your Free Call"
				/>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
</style>
