---
import MainLayout from '../layouts/MainLayout.astro';
import Cloud from '../components/Cloud.astro';
import CtaBand from '../components/CtaBand.astro';
import DiscoveryCallCard from '../components/DiscoveryCallCard.astro';
import Dot from '../components/Dot.astro';
import Icon from '../components/Icon.astro';
import PackagesSection from '../components/PackagesSection.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<MainLayout
	title="Services & Packages — Little Wonder Care"
	description="Gentle sleep coaching and postpartum doula services. Find the right support package for your family."
>
	<PageHero
		eyebrow="Services & Packages"
		title="Find the Right Support for Your Family"
		subtitle="Whether you need help with sleep, postpartum recovery, or just someone to talk to — I'm here. Choose the option that fits your needs."
		background="var(--crema)"
	>
		<Fragment slot="decor">
			<Cloud
				width={170}
				color="var(--celeste)"
				duration="22s"
				style="top:60px;left:5%"
			/>
			<Cloud
				width={140}
				color="var(--rosa-cipria)"
				opacity={0.7}
				duration="26s"
				delay="-6s"
				style="top:40px;right:7%"
			/>
			<Dot size={18} color="var(--pesca)" style="top:42%;left:16%" />
			<Dot
				size={12}
				color="var(--navy)"
				opacity={0.5}
				duration="7s"
				delay="-2s"
				style="top:30%;right:18%"
			/>
		</Fragment>

		<nav
			class="jump-links anim-fade-up"
			style="--anim-delay:0.5s"
			aria-label="Jump to a service"
		>
			<a href="#sleep">
				<Icon name="moon-star" size={16} /> Sleep Consulting
			</a>
			<a href="#doula">
				<Icon name="heart" size={16} class="heart" /> Postpartum Doula
			</a>
		</nav>
	</PageHero>

	<!-- Packages: sleep, doula, then the free discovery call -->
	<section class="packages">
		<div class="section-inner">
			<SectionHeader eyebrow="Packages" title="Services & Pricing" />
			<PackagesSection category="sleep" />
			<PackagesSection category="doula" />
			<DiscoveryCallCard />
		</div>
	</section>

	<CtaBand
		title="Ready to Take the First Step?"
		text="Book a free 15-minute call. Let's talk about your needs and find the right solution for your family."
		buttonLabel="Book Your Free Call"
	/>
</MainLayout>

<style>
	.jump-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.jump-links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: var(--off-white);
		color: var(--navy);
		padding: 10px 20px;
		border-radius: 50px;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
		transition:
			transform 0.3s,
			box-shadow 0.3s;
	}
	.jump-links a:hover {
		color: var(--navy);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(31, 56, 100, 0.1);
	}
	.jump-links :global(.heart) {
		color: var(--pesca);
	}

	.packages {
		padding: 60px 24px 110px;
	}

	@media (max-width: 600px) {
		.packages {
			padding: 40px 20px 72px;
		}
	}
</style>
