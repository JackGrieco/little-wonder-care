---
import MainLayout from '../layouts/MainLayout.astro';
import Cloud from '../components/Cloud.astro';
import CtaBand from '../components/CtaBand.astro';
import Dot from '../components/Dot.astro';
import FeatureCard from '../components/FeatureCard.astro';
import HeroLogo from '../components/HeroLogo.astro';
import Scallop from '../components/Scallop.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import { IS_BLOG_ENABLED, IS_LEAD_MAGNET_ENABLED } from '../consts';
import { getFeaturedTestimonials } from '../lib/sanity';

const testimonials = await getFeaturedTestimonials().catch(() => []);

const TRUST_POINTS = [
	'DONA Certified',
	'GSC Program Certified',
	'Waco, TX & Online',
	'Gentle Approach',
];

const STEPS = [
	{
		title: 'Book a Free Call',
		text: '15 minutes to get to know each other, understand your needs, and find the right path for you.',
	},
	{
		title: 'Personalized Plan',
		text: "I create a custom plan for your family, honoring your values and your baby's temperament.",
	},
	{
		title: 'Support & Results',
		text: 'I walk with you step by step with dedicated follow-ups until you feel confident and at peace.',
	},
];
---

<MainLayout>
	<!-- ===== HERO ===== -->
	<section class="hero">
		<Cloud width={180} opacity={0.55} duration="22s" style="top:70px;left:4%" />
		<Cloud
			width={120}
			opacity={0.4}
			duration="28s"
			delay="-9s"
			style="top:44%;right:44%"
		/>
		<Cloud
			width={150}
			color="var(--crema)"
			duration="26s"
			delay="-4s"
			style="top:40px;right:6%"
		/>

		<div class="hero-inner">
			<div class="hero-content">
				<p class="hero-pill anim-fade-up" style="--anim-dur:0.8s">
					Postpartum doula · Gentle sleep coach
				</p>
				<h1 class="hero-headline">
					<span class="anim-fade-up" style="--anim-delay:0.15s">
						You're in good hands.
					</span>
					<span class="anim-fade-up" style="--anim-delay:0.35s">
						And so is your baby.
					</span>
				</h1>
				<p class="hero-subtitle anim-fade-up" style="--anim-delay:0.55s">
					Gentle, professional support for your postpartum journey and your
					baby's sleep. In Waco and online nationwide.
				</p>
				<div class="hero-actions anim-fade-up" style="--anim-delay:0.7s">
					<a href="/contact" class="btn-cta">
						Let's Talk
					</a>
					<a href="/services" class="text-link">
						See services
					</a>
				</div>
			</div>
			<div class="anim-fade-up" style="--anim-dur:1s;--anim-delay:0.3s">
				<HeroLogo alt="Little Wonder Care" />
			</div>
		</div>

		<Scallop size="lg" />
	</section>

	<!-- ===== TRUST PILLS ===== -->
	<div class="trust-bar">
		<ul class="trust-list">
			{TRUST_POINTS.map((point, i) => (
				<li class="trust-pill" data-reveal="up" data-delay={i * 100}>
					{point}
				</li>
			))}
		</ul>
	</div>

	<!-- ===== SERVICES ===== -->
	<section class="services" id="services">
		<SectionHeader eyebrow="What I Do" title="My Services" />
		<div class="services-grid">
			<FeatureCard
				icon="moon-star"
				title="Gentle Sleep Coaching"
				text="A respectful, personalized approach to help your baby sleep better — no tears, no stress."
				background="var(--celeste)"
				href="/sleep-consulting"
			/>
			<FeatureCard
				icon="heart"
				title="Postpartum Support"
				text="Reassuring, hands-on support in the early weeks after birth. Emotional care, newborn guidance, and practical help."
				background="var(--crema)"
				decorColor="rgba(183, 201, 207, 0.35)"
				iconColor="var(--pesca)"
				href="/postpartum-doula"
				tilt="right"
				revealDelay={150}
			/>
			<FeatureCard
				icon="video"
				title="Online Consultation"
				text="A dedicated call to answer your questions about sleep, routines, and your baby's wellbeing. From anywhere."
				background="var(--rosa-cipria)"
				decorColor="rgba(232, 153, 132, 0.25)"
				iconColor="var(--rosa-scuro)"
				href="/services"
				revealDelay={300}
			/>
		</div>
	</section>

	<!-- ===== HOW IT WORKS ===== -->
	<Timeline eyebrow="How It Works" title="Three Simple Steps" steps={STEPS} />

	<!-- ===== ABOUT PREVIEW ===== -->
	<section class="about" id="about">
		<div class="about-inner">
			<div class="about-visual" data-reveal="scale" aria-hidden="true">
				<span class="about-glow anim-breathe"></span>
				<!-- Placeholder until Silvia's photo arrives -->
				<span class="about-avatar">S</span>
				<Dot
					size={22}
					color="var(--celeste)"
					duration="5s"
					style="top:30px;right:30px"
				/>
				<Dot
					size={14}
					color="var(--navy)"
					opacity={0.5}
					delay="-2s"
					style="bottom:40px;left:24px"
				/>
			</div>
			<div data-reveal="right" data-delay="150">
				<h2 class="about-name">Silvia</h2>
				<p class="about-role">Postpartum Doula · Gentle Sleep Coach</p>
				<p class="about-bio">
					I know what it means to wake up for the fifth time in one night and
					feel completely alone. That's why I chose this work: to be the person
					I wished I'd had by my side. No judgment, just real support.
				</p>
				<a href="/about" class="btn-outline about-button">
					Meet Silvia
				</a>
			</div>
		</div>
	</section>

	<!-- ===== TESTIMONIALS (Sanity) ===== -->
	<section class="testimonials">
		<SectionHeader eyebrow="Moms Say" title="Real Stories" />

		<div class="testimonials-list" data-reveal="up" data-delay="150">
			{testimonials.length > 0 ? (
				testimonials.map((t) => (
					<figure class="testimonial-card">
						{t.rating && t.rating > 0 && (
							<div
								class="testimonial-stars"
								aria-label={`${t.rating} out of 5 stars`}
							>
								{'★'.repeat(t.rating)}
								{'☆'.repeat(5 - t.rating)}
							</div>
						)}
						<blockquote class="testimonial-quote">{t.quote}</blockquote>
						<figcaption>
							<p class="testimonial-author">{t.name}</p>
							{(t.serviceType || t.childAge) && (
								<p class="testimonial-detail">
									{[t.serviceType, t.childAge ? `· ${t.childAge}` : '']
										.filter(Boolean)
										.join(' ')}
								</p>
							)}
						</figcaption>
					</figure>
				))
			) : (
				/* Fallback when no featured testimonials exist in Sanity yet */
				<figure class="testimonial-card">
					<blockquote class="testimonial-quote">
						Silvia was my anchor in the early weeks. I didn't know what was
						normal and what wasn't, and she was always there with calm and
						confidence. My baby started sleeping better and I started feeling
						like myself again.
					</blockquote>
					<figcaption>
						<p class="testimonial-author">Maria R.</p>
						<p class="testimonial-detail">Mom of Luca, 4 months</p>
					</figcaption>
				</figure>
			)}
		</div>

		<div class="testimonials-more">
			<a href="/testimonials" class="btn-outline">
				Read All Stories
			</a>
		</div>
	</section>

	<!-- ===== BLOG PREVIEW ===== -->
	{IS_BLOG_ENABLED && (
		<section class="blog-preview" id="blog">
			<div class="section-header">
				<p class="section-eyebrow">From the Blog</p>
				<h2 class="section-title">Resources for Parents</h2>
			</div>
			<div class="blog-grid">
				<div class="blog-card">
					<div class="blog-card-image">
						<span>Sleep</span>
					</div>
					<div class="blog-card-body">
						<h3>
							What Does a Postpartum Doula Do? Everything You Need to Know
						</h3>
						<p>
							The complete guide to understanding how a doula can support you in
							the early weeks.
						</p>
					</div>
				</div>
				<div class="blog-card">
					<div class="blog-card-image">
						<span>Postpartum</span>
					</div>
					<div class="blog-card-body">
						<h3>5 Signs Your Baby Is Ready for Sleep Training</h3>
						<p>How to recognize the right time to start a sleep journey.</p>
					</div>
				</div>
				<div class="blog-card">
					<div class="blog-card-image">
						<span>Guide</span>
					</div>
					<div class="blog-card-body">
						<h3>How to Survive the 4-Month Sleep Regression</h3>
						<p>
							Practical strategies to navigate one of the toughest moments of
							the first year.
						</p>
					</div>
				</div>
			</div>
			<div style="text-align:center; margin-top: 40px;">
				<a href="/blog" class="btn-outline">
					Read All Articles
				</a>
			</div>
		</section>
	)}

	<!-- ===== LEAD MAGNET ===== -->
	{IS_LEAD_MAGNET_ENABLED && (
		<section class="lead-magnet">
			<div class="lead-magnet-inner">
				<h2 class="section-title">Free Newborn Sleep Guide</h2>
				<p>Download the guide and get practical tips straight to your inbox.</p>
				<form class="email-form" onsubmit="return false;">
					<input
						type="email"
						placeholder="Your email address..."
						aria-label="Email address"
					/>
					<button type="submit">Download</button>
				</form>
			</div>
		</section>
	)}

	<!-- ===== FINAL CTA BAND ===== -->
	<CtaBand
		title="Ready to Take the First Step?"
		text="Book a free 15-minute call. Let's talk about your needs and find the right solution for your family."
		buttonLabel="Book Your Free Call"
	/>
</MainLayout>

<style>
	/* ===== HERO ===== */
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--celeste);
		padding: 96px 24px 180px;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 60px;
		align-items: center;
	}

	.hero-content {
		max-width: 540px;
	}

	.hero-headline {
		font-family: var(--font-display);
		font-size: 4rem;
		font-weight: 400;
		line-height: 1.05;
		color: var(--navy);
		margin: 0 0 24px;
	}
	.hero-headline span {
		display: block;
	}

	.hero-subtitle {
		font-size: 1.08rem;
		color: var(--navy);
		line-height: 1.7;
		max-width: 440px;
		margin: 0 0 36px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.text-link {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--navy);
		text-decoration: none;
		border-bottom: 2px solid rgba(31, 56, 100, 0.25);
		padding-bottom: 2px;
		transition:
			border-color 0.2s,
			color 0.2s;
	}
	.text-link:hover {
		color: var(--navy);
		border-color: var(--pesca);
	}

	/* ===== TRUST PILLS ===== */
	.trust-bar {
		padding: 12px 24px 40px;
	}

	.trust-list {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.trust-pill {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--navy);
		background: #fff;
		padding: 10px 20px;
		border-radius: 50px;
		box-shadow: 0 2px 12px rgba(31, 56, 100, 0.06);
	}
	.trust-pill::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--pesca);
	}

	/* ===== SERVICES ===== */
	.services {
		padding: 80px 24px 120px;
	}

	.services-grid {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 28px;
		align-items: stretch;
	}

	/* ===== ABOUT PREVIEW ===== */
	.about {
		background: var(--rosa-cipria);
		padding: 110px 24px;
		overflow: hidden;
	}

	.about-inner {
		max-width: 1000px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 320px minmax(0, 1fr);
		gap: 72px;
		align-items: center;
	}

	.about-visual {
		position: relative;
		height: 320px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.about-glow {
		position: absolute;
		width: 300px;
		height: 300px;
		border-radius: 50%;
		background: rgba(250, 249, 246, 0.5);
	}

	.about-avatar {
		position: relative;
		width: 200px;
		height: 200px;
		border-radius: 50%;
		background: var(--pesca);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-size: 5rem;
		color: var(--navy);
	}

	.about-name {
		font-family: var(--font-display);
		font-size: 3rem;
		font-weight: 400;
		line-height: 1;
		color: var(--rosa-scuro);
		margin: 0 0 4px;
	}

	.about-role {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--rosa-scuro);
		font-weight: 500;
		margin: 0 0 28px;
	}

	.about-bio {
		font-size: 1.2rem;
		line-height: 1.75;
		color: rgba(45, 45, 45, 0.85);
		font-style: italic;
		margin: 0;
		text-wrap: pretty;
	}

	.about-button {
		margin-top: 32px;
	}

	/* ===== TESTIMONIALS ===== */
	.testimonials {
		padding: 110px 24px;
	}

	.testimonials-list {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 64px 28px;
		padding-top: 34px; /* room for the quote circle */
	}

	/* A single testimonial (fallback or one result) stays centred */
	.testimonials-list:has(> :only-child) {
		grid-template-columns: minmax(0, 760px);
		justify-content: center;
	}

	.testimonial-card {
		position: relative;
		margin: 0;
		background: var(--crema);
		border-radius: 32px;
		padding: 64px 64px 48px;
		text-align: center;
	}

	/* Peach circle with an opening quote mark, overlapping the top edge */
	.testimonial-card::before {
		content: '\201C';
		position: absolute;
		top: -34px;
		left: 50%;
		margin-left: -34px;
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: var(--pesca);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 18px;
		font-family: var(--font-display);
		font-size: 3.4rem;
		line-height: 1;
		color: var(--navy);
	}

	.testimonial-stars {
		font-size: 1rem;
		color: var(--pesca);
		letter-spacing: 0.05em;
		margin-bottom: 14px;
	}

	.testimonial-quote {
		border: none;
		padding: 0;
		margin: 0 0 28px;
		font-family: var(--font-display);
		font-size: 1.6rem;
		line-height: 1.5;
		color: var(--charcoal);
		text-wrap: pretty;
	}

	.testimonial-author {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--navy);
		margin: 0;
	}

	.testimonial-detail {
		font-size: 0.78rem;
		color: rgba(92, 74, 42, 0.75);
		margin: 2px 0 0;
	}

	.testimonials-more {
		text-align: center;
		margin-top: 40px;
	}

	/* ===== BLOG PREVIEW ===== */
	.blog-preview {
		padding: var(--section-padding);
		background: var(--off-white);
	}

	.blog-grid {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.blog-card {
		background: #fff;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.blog-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07);
	}

	.blog-card-image {
		height: 160px;
		background: var(--celeste);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.blog-card-image span {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--navy);
		background: rgba(255, 255, 255, 0.6);
		padding: 6px 14px;
		border-radius: 20px;
	}

	.blog-card:nth-child(2) .blog-card-image {
		background: var(--crema);
	}
	.blog-card:nth-child(2) .blog-card-image span {
		color: var(--navy);
	}
	.blog-card:nth-child(3) .blog-card-image {
		background: var(--rosa-cipria);
	}
	.blog-card:nth-child(3) .blog-card-image span {
		color: var(--rosa-scuro);
	}

	.blog-card-body {
		padding: 24px;
	}

	.blog-card-body h3 {
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 400;
		color: var(--charcoal);
		margin-bottom: 8px;
		line-height: 1.35;
	}

	.blog-card-body p {
		font-size: 0.85rem;
		color: rgba(45, 45, 45, 0.6);
		line-height: 1.55;
		margin: 0;
	}

	/* ===== LEAD MAGNET ===== */
	.lead-magnet {
		padding: 60px 24px;
		background: var(--crema);
	}

	.lead-magnet-inner {
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
		background: #fff;
		padding: 48px 40px;
		border-radius: 24px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
	}

	.lead-magnet-inner .section-title {
		font-size: 1.6rem;
		margin-bottom: 12px;
	}

	.lead-magnet-inner p {
		font-size: 0.95rem;
		color: rgba(45, 45, 45, 0.7);
		margin-bottom: 24px;
	}

	.email-form {
		display: flex;
		gap: 12px;
		max-width: 420px;
		margin: 0 auto;
	}

	.email-form input {
		flex: 1;
		padding: 12px 20px;
		border: 1px solid rgba(183, 201, 206, 0.5);
		border-radius: 50px;
		font-size: 0.9rem;
		outline: none;
		font-family: var(--font-sans);
		background: var(--off-white);
		color: var(--charcoal);
		transition: border-color 0.2s;
	}

	.email-form input:focus {
		border-color: var(--celeste);
	}

	.email-form button {
		background: var(--pesca);
		color: var(--navy);
		border: none;
		padding: 12px 28px;
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s;
		white-space: nowrap;
		font-family: var(--font-sans);
	}

	.email-form button:hover {
		background: var(--navy);
		color: #fff !important;
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 24px;
		}
		.hero-content {
			margin: 0 auto;
		}
		.hero-subtitle {
			margin: 0 auto 32px;
		}
		.hero-actions {
			justify-content: center;
		}
		.hero-headline {
			font-size: 3.2rem;
		}

		.services-grid,
		.blog-grid {
			grid-template-columns: minmax(0, 1fr);
			max-width: 480px;
		}

		.about-inner {
			grid-template-columns: 1fr;
			gap: 32px;
			text-align: center;
		}
		.about-visual {
			height: 280px;
		}

		.email-form {
			flex-direction: column;
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: 56px 20px 120px;
		}
		.hero-headline {
			font-size: 2.6rem;
		}
		.services,
		.about,
		.testimonials {
			padding: 72px 20px;
		}
		.about-bio {
			font-size: 1.05rem;
		}
		.testimonial-card {
			padding: 56px 24px 36px;
		}
		.testimonial-quote {
			font-size: 1.35rem;
		}
		.lead-magnet-inner {
			padding: 32px 24px;
		}
	}
</style>
