---
// Small decorative circle that floats up and down. Position it with `style`.
interface Props {
	size: number;
	color: string;
	opacity?: number;
	duration?: string;
	delay?: string;
	style?: string;
}

const {
	size,
	color,
	opacity = 1,
	duration = '6s',
	delay = '0s',
	style = '',
} = Astro.props;
---

<span
	class="dot anim-float"
	aria-hidden="true"
	style={`width:${size}px;height:${size}px;background:${color};opacity:${opacity};--anim-dur:${duration};--anim-delay:${delay};${style}`}
></span>

<style>
	.dot {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}
</style>
