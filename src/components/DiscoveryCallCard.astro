---
// The "third service": a free 15-minute call for people who don't know which
// package fits them. Shown under the packages on every services page.
import DiscoveryCallButton from './DiscoveryCallButton.astro';
import Dot from './Dot.astro';
import type { Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale].discoveryCall;
---

<section
	class="discovery-call-card"
	aria-label={ui.cardAriaLabel}
	data-reveal="scale"
>
	<span class="corner-circle anim-breathe" aria-hidden="true"></span>
	<Dot
		size={14}
		color="var(--pesca)"
		duration="5s"
		style="left:30px;bottom:24px"
	/>
	<div class="content">
		<span class="discovery-tag">{ui.cardTag}</span>
		<h3>{ui.cardTitle}</h3>
		<p>{ui.cardText}</p>
		<DiscoveryCallButton locale={locale} label={ui.cardButton} />
	</div>
</section>

<style>
	.discovery-call-card {
		position: relative;
		overflow: hidden;
		max-width: 760px;
		margin: 24px auto 0;
		padding: 52px 48px;
		border-radius: 32px;
		background: var(--rosa-cipria);
		text-align: center;
	}

	.corner-circle {
		position: absolute;
		right: -40px;
		top: -40px;
		width: 140px;
		height: 140px;
		border-radius: 50%;
		background: var(--off-white);
		opacity: 0.4;
	}

	.content {
		position: relative;
	}

	.discovery-tag {
		display: inline-block;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 600;
		padding: 5px 14px;
		border-radius: 20px;
		margin-bottom: 18px;
		background: var(--pesca);
		color: var(--navy);
	}

	h3 {
		font-family: var(--font-display);
		font-size: 2.2rem;
		font-weight: 400;
		line-height: 1.1;
		color: var(--navy);
		margin: 0 0 12px;
	}

	p {
		font-size: 0.95rem;
		line-height: 1.65;
		color: rgba(45, 45, 45, 0.8);
		max-width: 480px;
		margin: 0 auto 28px;
	}

	@media (max-width: 600px) {
		.discovery-call-card {
			padding: 44px 24px;
		}
		h3 {
			font-size: 1.9rem;
		}
	}
</style>
