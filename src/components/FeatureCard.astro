---
// Colored card with an icon circle, title and text; lifts and tilts slightly
// on hover. Used for the home services, doula features and credentials.
import Icon, { type IconName } from './Icon.astro';

interface Props {
	icon: IconName;
	title: string;
	text: string;
	background: string;
	/** Color of the soft circle peeking in from the top-right corner. */
	decorColor?: string;
	iconColor?: string;
	iconBackground?: string;
	/** Optional "Learn More" link at the bottom of the card. */
	href?: string;
	tilt?: 'left' | 'right';
	revealDelay?: number;
}

const {
	icon,
	title,
	text,
	background,
	decorColor = 'rgba(250, 249, 246, 0.35)',
	iconColor = 'var(--navy)',
	iconBackground = 'var(--off-white)',
	href,
	tilt = 'left',
	revealDelay = 0,
} = Astro.props;
---

<div class="card-wrap" data-reveal="up" data-delay={revealDelay}>
	<article
		class:list={['card', `tilt-${tilt}`]}
		style={`background:${background};--decor:${decorColor}`}
	>
		<span
			class="icon-circle"
			style={`color:${iconColor};background:${iconBackground}`}
		>
			<Icon name={icon} size={30} />
		</span>
		<h3>{title}</h3>
		<p>{text}</p>
		{href && (
			<a href={href} class="card-link">
				Learn More{' '}
				<span class="arrow" aria-hidden="true">
					→
				</span>
			</a>
		)}
	</article>
</div>

<style>
	/* The reveal transform lives on the wrapper so it never fights the hover */
	.card-wrap {
		display: flex;
		flex-direction: column;
	}

	.card {
		position: relative;
		overflow: hidden;
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: 44px 34px;
		border-radius: 28px;
		transition:
			transform 0.4s var(--ease-soft),
			box-shadow 0.4s;
	}
	.card::before {
		content: '';
		position: absolute;
		right: -50px;
		top: -50px;
		width: 150px;
		height: 150px;
		border-radius: 50%;
		background: var(--decor);
	}
	.card:hover {
		box-shadow: 0 20px 50px rgba(31, 56, 100, 0.12);
	}
	.card.tilt-left:hover {
		transform: translateY(-8px) rotate(-0.6deg);
	}
	.card.tilt-right:hover {
		transform: translateY(-8px) rotate(0.6deg);
	}

	.icon-circle {
		position: relative;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
	}

	h3 {
		font-family: var(--font-display);
		font-size: 1.8rem;
		font-weight: 400;
		line-height: 1.1;
		color: var(--navy);
		margin: 0 0 12px;
	}

	p {
		flex: 1;
		font-size: 0.92rem;
		line-height: 1.65;
		color: rgba(45, 45, 45, 0.78);
		margin: 0;
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 24px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--navy);
		text-decoration: none;
	}
	.arrow {
		display: inline-flex;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--off-white);
		align-items: center;
		justify-content: center;
		transition: transform 0.3s var(--ease-soft);
	}
	.card-link:hover .arrow {
		transform: translateX(4px);
	}
</style>
