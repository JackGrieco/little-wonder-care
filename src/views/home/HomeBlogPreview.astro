---
// Home page "From the Blog" preview with placeholder articles.
// US site only (no Italian blog or lead magnet planned), hidden behind a
// feature flag in src/consts.ts.
---

<section class="blog-preview" id="blog">
	<div class="section-header">
		<p class="section-eyebrow">From the Blog</p>
		<h2 class="section-title">Resources for Parents</h2>
	</div>
	<div class="blog-grid">
		<div class="blog-card">
			<div class="blog-card-image">
				<span>Sleep</span>
			</div>
			<div class="blog-card-body">
				<h3>What Does a Postpartum Doula Do? Everything You Need to Know</h3>
				<p>
					The complete guide to understanding how a doula can support you in the
					early weeks.
				</p>
			</div>
		</div>
		<div class="blog-card">
			<div class="blog-card-image">
				<span>Postpartum</span>
			</div>
			<div class="blog-card-body">
				<h3>5 Signs Your Baby Is Ready for Sleep Training</h3>
				<p>How to recognize the right time to start a sleep journey.</p>
			</div>
		</div>
		<div class="blog-card">
			<div class="blog-card-image">
				<span>Guide</span>
			</div>
			<div class="blog-card-body">
				<h3>How to Survive the 4-Month Sleep Regression</h3>
				<p>
					Practical strategies to navigate one of the toughest moments of the
					first year.
				</p>
			</div>
		</div>
	</div>
	<div style="text-align:center; margin-top: 40px;">
		<a href="/blog" class="btn-outline">
			Read All Articles
		</a>
	</div>
</section>

<style>
	/* ===== BLOG PREVIEW ===== */
	.blog-preview {
		padding: var(--section-padding);
		background: var(--off-white);
	}

	.blog-grid {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.blog-card {
		background: #fff;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.blog-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07);
	}

	.blog-card-image {
		height: 160px;
		background: var(--celeste);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.blog-card-image span {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--navy);
		background: rgba(255, 255, 255, 0.6);
		padding: 6px 14px;
		border-radius: 20px;
	}

	.blog-card:nth-child(2) .blog-card-image {
		background: var(--crema);
	}
	.blog-card:nth-child(2) .blog-card-image span {
		color: var(--navy);
	}
	.blog-card:nth-child(3) .blog-card-image {
		background: var(--rosa-cipria);
	}
	.blog-card:nth-child(3) .blog-card-image span {
		color: var(--rosa-scuro);
	}

	.blog-card-body {
		padding: 24px;
	}

	.blog-card-body h3 {
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 400;
		color: var(--charcoal);
		margin-bottom: 8px;
		line-height: 1.35;
	}

	.blog-card-body p {
		font-size: 0.85rem;
		color: rgba(45, 45, 45, 0.6);
		line-height: 1.55;
		margin: 0;
	}

	@media (max-width: 900px) {
		.blog-grid {
			grid-template-columns: minmax(0, 1fr);
			max-width: 480px;
		}
	}
</style>
