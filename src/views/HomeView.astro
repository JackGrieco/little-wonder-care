---
import MainLayout from '../layouts/MainLayout.astro';
import Cloud from '../components/Cloud.astro';
import CtaBand from '../components/CtaBand.astro';
import Dot from '../components/Dot.astro';
import FeatureCard from '../components/FeatureCard.astro';
import HeroLogo from '../components/HeroLogo.astro';
import Scallop from '../components/Scallop.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import HomeBlogPreview from './home/HomeBlogPreview.astro';
import HomeLeadMagnet from './home/HomeLeadMagnet.astro';
import { IS_BLOG_ENABLED, IS_LEAD_MAGNET_ENABLED } from '../consts';
import { HOME_COPY } from '../i18n/copy/home';
import { localizePath, type Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { getFeaturedTestimonials } from '../lib/sanity';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale];
const to = (href: string) => localizePath(href, locale);
const serviceLabels = UI[locale].testimonialFilters;
// The blog and the lead magnet exist on the US site only (no Italian blog).
const isUsSite = locale === 'en';

const testimonials = await getFeaturedTestimonials(locale).catch(() => []);
---

<MainLayout
	locale={locale}
	title={copy.meta.title}
	description={copy.meta.description}
>
	<!-- ===== HERO ===== -->
	<section class="hero">
		<Cloud width={180} opacity={0.55} duration="22s" style="top:70px;left:4%" />
		<Cloud
			width={120}
			opacity={0.4}
			duration="28s"
			delay="-9s"
			style="top:44%;right:44%"
		/>
		<Cloud
			width={150}
			color="var(--crema)"
			duration="26s"
			delay="-4s"
			style="top:40px;right:6%"
		/>

		<div class="hero-inner">
			<div class="hero-content">
				<p class="hero-pill anim-fade-up" style="--anim-dur:0.8s">
					{copy.hero.pill}
				</p>
				<h1 class="hero-headline">
					<span class="anim-fade-up" style="--anim-delay:0.15s">
						{copy.hero.headline[0]}
					</span>
					<span class="anim-fade-up" style="--anim-delay:0.35s">
						{copy.hero.headline[1]}
					</span>
				</h1>
				<p class="hero-subtitle anim-fade-up" style="--anim-delay:0.55s">
					{copy.hero.subtitle}
				</p>
				<div class="hero-actions anim-fade-up" style="--anim-delay:0.7s">
					<a href={to('/contact')} class="btn-cta">
						{copy.hero.primaryCta}
					</a>
					<a href={to('/services')} class="text-link">
						{copy.hero.secondaryCta}
					</a>
				</div>
			</div>
			<div class="anim-fade-up" style="--anim-dur:1s;--anim-delay:0.3s">
				<HeroLogo alt="Little Wonder Care" />
			</div>
		</div>

		<Scallop size="lg" />
	</section>

	<!-- ===== TRUST PILLS ===== -->
	<div class="trust-bar">
		<ul class="trust-list">
			{copy.trustPoints.map((point, i) => (
				<li class="trust-pill" data-reveal="up" data-delay={i * 100}>
					{point}
				</li>
			))}
		</ul>
	</div>

	<!-- ===== SERVICES ===== -->
	<section class="services" id="services">
		<SectionHeader
			eyebrow={copy.services.eyebrow}
			title={copy.services.title}
		/>
		<div class="services-grid">
			<FeatureCard
				locale={locale}
				icon="moon-star"
				title={copy.services.items[0].title}
				text={copy.services.items[0].text}
				background="var(--celeste)"
				href={to('/sleep-consulting')}
			/>
			<FeatureCard
				locale={locale}
				icon="heart"
				title={copy.services.items[1].title}
				text={copy.services.items[1].text}
				background="var(--crema)"
				decorColor="rgba(183, 201, 207, 0.35)"
				iconColor="var(--pesca)"
				href={to('/postpartum-doula')}
				tilt="right"
				revealDelay={150}
			/>
			<FeatureCard
				locale={locale}
				icon="video"
				title={copy.services.items[2].title}
				text={copy.services.items[2].text}
				background="var(--rosa-cipria)"
				decorColor="rgba(232, 153, 132, 0.25)"
				iconColor="var(--rosa-scuro)"
				href={to('/services')}
				revealDelay={300}
			/>
		</div>
	</section>

	<!-- ===== HOW IT WORKS ===== -->
	<Timeline
		eyebrow={copy.steps.eyebrow}
		title={copy.steps.title}
		steps={copy.steps.items}
	/>

	<!-- ===== ABOUT PREVIEW ===== -->
	<section class="about" id="about">
		<div class="about-inner">
			<div class="about-visual" data-reveal="scale" aria-hidden="true">
				<span class="about-glow anim-breathe"></span>
				<!-- Placeholder until Silvia's photo arrives -->
				<span class="about-avatar">S</span>
				<Dot
					size={22}
					color="var(--celeste)"
					duration="5s"
					style="top:30px;right:30px"
				/>
				<Dot
					size={14}
					color="var(--navy)"
					opacity={0.5}
					delay="-2s"
					style="bottom:40px;left:24px"
				/>
			</div>
			<div data-reveal="right" data-delay="150">
				<h2 class="about-name">Silvia</h2>
				<p class="about-role">{copy.about.role}</p>
				<p class="about-bio">{copy.about.bio}</p>
				<a href={to('/about')} class="btn-outline about-button">
					{copy.about.button}
				</a>
			</div>
		</div>
	</section>

	<!-- ===== TESTIMONIALS (Sanity) ===== -->
	<section class="testimonials">
		<SectionHeader
			eyebrow={copy.testimonials.eyebrow}
			title={copy.testimonials.title}
		/>

		<div class="testimonials-list" data-reveal="up" data-delay="150">
			{testimonials.length > 0 ? (
				testimonials.map((t) => (
					<figure class="testimonial-card">
						{t.rating && t.rating > 0 && (
							<div
								class="testimonial-stars"
								aria-label={copy.testimonials.starsLabel.replace(
									'{rating}',
									String(t.rating),
								)}
							>
								{'★'.repeat(t.rating)}
								{'☆'.repeat(5 - t.rating)}
							</div>
						)}
						<blockquote class="testimonial-quote">{t.quote}</blockquote>
						<figcaption>
							<p class="testimonial-author">{t.name}</p>
							{(t.serviceType || t.childAge) && (
								<p class="testimonial-detail">
									{[
										t.serviceType && serviceLabels[t.serviceType],
										t.childAge ? `· ${t.childAge}` : '',
									]
										.filter(Boolean)
										.join(' ')}
								</p>
							)}
						</figcaption>
					</figure>
				))
			) : (
				/* Fallback when no featured testimonials exist in Sanity yet */
				<figure class="testimonial-card">
					<blockquote class="testimonial-quote">
						{copy.testimonials.fallback.quote}
					</blockquote>
					<figcaption>
						<p class="testimonial-author">
							{copy.testimonials.fallback.author}
						</p>
						<p class="testimonial-detail">
							{copy.testimonials.fallback.detail}
						</p>
					</figcaption>
				</figure>
			)}
		</div>

		<div class="testimonials-more">
			<a href={to('/testimonials')} class="btn-outline">
				{copy.testimonials.more}
			</a>
		</div>
	</section>

	<!-- ===== BLOG PREVIEW ===== -->
	{IS_BLOG_ENABLED && isUsSite && <HomeBlogPreview />}

	<!-- ===== LEAD MAGNET ===== -->
	{IS_LEAD_MAGNET_ENABLED && isUsSite && <HomeLeadMagnet />}

	<!-- ===== FINAL CTA BAND ===== -->
	<CtaBand
		locale={locale}
		title={copy.cta.title}
		text={copy.cta.text}
		buttonLabel={copy.cta.buttonLabel}
	/>
</MainLayout>

<style>
	/* ===== HERO ===== */
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--celeste);
		padding: 96px 24px 180px;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 60px;
		align-items: center;
	}

	.hero-content {
		max-width: 540px;
	}

	.hero-headline {
		font-family: var(--font-display);
		font-size: 4rem;
		font-weight: 400;
		line-height: 1.05;
		color: var(--navy);
		margin: 0 0 24px;
	}
	.hero-headline span {
		display: block;
	}

	.hero-subtitle {
		font-size: 1.08rem;
		color: var(--navy);
		line-height: 1.7;
		max-width: 440px;
		margin: 0 0 36px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.text-link {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--navy);
		text-decoration: none;
		border-bottom: 2px solid rgba(31, 56, 100, 0.25);
		padding-bottom: 2px;
		transition:
			border-color 0.2s,
			color 0.2s;
	}
	.text-link:hover {
		color: var(--navy);
		border-color: var(--pesca);
	}

	/* ===== TRUST PILLS ===== */
	.trust-bar {
		padding: 12px 24px 40px;
	}

	.trust-list {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.trust-pill {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--navy);
		background: #fff;
		padding: 10px 20px;
		border-radius: 50px;
		box-shadow: 0 2px 12px rgba(31, 56, 100, 0.06);
	}
	.trust-pill::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--pesca);
	}

	/* ===== SERVICES ===== */
	.services {
		padding: 80px 24px 120px;
	}

	.services-grid {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 28px;
		align-items: stretch;
	}

	/* ===== ABOUT PREVIEW ===== */
	.about {
		background: var(--rosa-cipria);
		padding: 110px 24px;
		overflow: hidden;
	}

	.about-inner {
		max-width: 1000px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 320px minmax(0, 1fr);
		gap: 72px;
		align-items: center;
	}

	.about-visual {
		position: relative;
		height: 320px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.about-glow {
		position: absolute;
		width: 300px;
		height: 300px;
		border-radius: 50%;
		background: rgba(250, 249, 246, 0.5);
	}

	.about-avatar {
		position: relative;
		width: 200px;
		height: 200px;
		border-radius: 50%;
		background: var(--pesca);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-size: 5rem;
		color: var(--navy);
	}

	.about-name {
		font-family: var(--font-display);
		font-size: 3rem;
		font-weight: 400;
		line-height: 1;
		color: var(--rosa-scuro);
		margin: 0 0 4px;
	}

	.about-role {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--rosa-scuro);
		font-weight: 500;
		margin: 0 0 28px;
	}

	.about-bio {
		font-size: 1.2rem;
		line-height: 1.75;
		color: rgba(45, 45, 45, 0.85);
		font-style: italic;
		margin: 0;
		text-wrap: pretty;
	}

	.about-button {
		margin-top: 32px;
	}

	/* ===== TESTIMONIALS ===== */
	.testimonials {
		padding: 110px 24px;
	}

	.testimonials-list {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 64px 28px;
		padding-top: 34px; /* room for the quote circle */
	}

	/* A single testimonial (fallback or one result) stays centred */
	.testimonials-list:has(> :only-child) {
		grid-template-columns: minmax(0, 760px);
		justify-content: center;
	}

	.testimonial-card {
		position: relative;
		margin: 0;
		background: var(--crema);
		border-radius: 32px;
		padding: 64px 64px 48px;
		text-align: center;
	}

	/* Peach circle with an opening quote mark, overlapping the top edge */
	.testimonial-card::before {
		content: '\201C';
		position: absolute;
		top: -34px;
		left: 50%;
		margin-left: -34px;
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: var(--pesca);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 18px;
		font-family: var(--font-display);
		font-size: 3.4rem;
		line-height: 1;
		color: var(--navy);
	}

	.testimonial-stars {
		font-size: 1rem;
		color: var(--pesca);
		letter-spacing: 0.05em;
		margin-bottom: 14px;
	}

	.testimonial-quote {
		border: none;
		padding: 0;
		margin: 0 0 28px;
		font-family: var(--font-display);
		font-size: 1.6rem;
		line-height: 1.5;
		color: var(--charcoal);
		text-wrap: pretty;
	}

	.testimonial-author {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--navy);
		margin: 0;
	}

	.testimonial-detail {
		font-size: 0.78rem;
		color: rgba(92, 74, 42, 0.75);
		margin: 2px 0 0;
	}

	.testimonials-more {
		text-align: center;
		margin-top: 40px;
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 24px;
		}
		.hero-content {
			margin: 0 auto;
		}
		.hero-subtitle {
			margin: 0 auto 32px;
		}
		.hero-actions {
			justify-content: center;
		}
		.hero-headline {
			font-size: 3.2rem;
		}

		.services-grid {
			grid-template-columns: minmax(0, 1fr);
			max-width: 480px;
		}

		.about-inner {
			grid-template-columns: 1fr;
			gap: 32px;
			text-align: center;
		}
		.about-visual {
			height: 280px;
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: 56px 20px 120px;
		}
		.hero-headline {
			font-size: 2.6rem;
		}
		.services,
		.about,
		.testimonials {
			padding: 72px 20px;
		}
		.about-bio {
			font-size: 1.05rem;
		}
		.testimonial-card {
			padding: 56px 24px 36px;
		}
		.testimonial-quote {
			font-size: 1.35rem;
		}
	}
</style>
